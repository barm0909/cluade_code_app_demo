# cp terraform.tfvars.example terraform.tfvars してから値を書き換えてください
aws_region          = "ap-northeast-1"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
admin_ssh_cidr      = "203.0.113.10/32" # curl ifconfig.me で自分のIPを確認して置き換える

# サイト全体にかけるBasic認証(HTTPは全IPに公開されるが、ID/パスワードで保護する)
basic_auth_username = "admin"
basic_auth_password = "change-me-to-a-strong-password"
